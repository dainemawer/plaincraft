# Canonical origin used for metadata, sitemap, robots and JSON-LD.
SITE_URL=https://plaincraft.co.za

# Resend: sends founding-client applications and keeps the spot count.
# The sending domain (plaincraft.co.za) must be verified in Resend.
RESEND_API_KEY=
# Segment that applicants are added to; its size drives "x of 5 spots filled".
RESEND_FOUNDING_SEGMENT_ID=
# Segment that confirmed newsletter subscribers are added to.
RESEND_NEWSLETTER_SEGMENT_ID=
# Optional. Signs newsletter confirmation links; derived from RESEND_API_KEY if unset.
NEWSLETTER_SECRET=
# Optional. Defaults to "Daine Mawer <hello@plaincraft.co.za>".
RESEND_FROM=
